  "bugs": {
    "url": "https://github.com/tensorlakeai/opencode-tensorlake-plugin/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.21",
    "tensorlake": "0.5.112",
    "xdg-basedir": "^5.1.0",
    "zod": "^4.2.1"
  },
